{
  "expo": {
    "name": "하루 OX 캘린더",
    "slug": "today-receipt",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cb553c3e-d067-46a9-8356-574a1a467fa4"
    },
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#2457D6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyeheee.todayreceipt"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.hyeheee.todayreceipt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-SemiBold.ttf",
            "./assets/fonts/Pretendard-Bold.ttf",
            "./assets/fonts/Pretendard-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#101418"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5927873314061819~3805449410"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableOnBackInvokedCallback": true,
            "extraGCMSenderIds": [],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libjsc.so"
              ]
            }
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-Bold.ttf",
            "./assets/fonts/Pretendard-ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayOX",
              "label": "오늘 한 칸",
              "description": "탭 한 번으로 오늘을 O, X로 기록해요",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeekOX",
              "label": "이번 주",
              "description": "이번 주 7일을 위젯에서 바로 기록해요",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MonthOX",
              "label": "이번 달",
              "description": "이번 달 달력에서 지난 날까지 바로 기록해요",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "cb553c3e-d067-46a9-8356-574a1a467fa4"
      }
    },
    "scheme": "haruox"
  }
}
