{
  "expo": {
    "name": "오늘의 영수증",
    "slug": "today-receipt",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/today-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/today-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/today-icon.png",
      "color": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyeheee.todayreceipt"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.hyeheee.todayreceipt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/today-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5927873314061819~3805449410"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "사용자가 사진을 선택할 수 있도록 앨범에 접근합니다.",
          "cameraPermission": "사진을 촬영할 수 있도록 카메라에 접근합니다."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableOnBackInvokedCallback": true,
            "extraGCMSenderIds": [],
            "packagingOptions": {
              "pickFirst": [
                "**/libjsc.so"
              ]
            }
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "cb553c3e-d067-46a9-8356-574a1a467fa4"
      }
    }
  }
}
