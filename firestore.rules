rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function familyIdOf(uid) {
      return exists(/databases/$(database)/documents/userFamily/$(uid))
        ? get(/databases/$(database)/documents/userFamily/$(uid)).data.familyId
        : null;
    }

    match /receipts/{receiptId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        (familyIdOf(request.auth.uid) != null &&
         familyIdOf(request.auth.uid) == familyIdOf(resource.data.userId))
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.memberIds.size() <= 2;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      ) && request.resource.data.memberIds.size() <= 2;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /userFamily/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == uid ||
        (resource != null &&
         request.auth.uid == get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId)
      );
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if false;
    }

    match /pushTokens/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
